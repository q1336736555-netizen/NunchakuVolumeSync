<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cn.local.usbtile">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35"/>
    <queries><package android:name="com.netease.cloudmusic"/></queries>
    <application android:label="网易云 USB 独占" android:icon="@drawable/usb" android:allowBackup="false">
        <service android:name=".UsbTile" android:label="USB 独占" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name=".Navigation" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/navigation"/>
        </service>
        <activity android:name=".ToggleActivity" android:exported="false" android:excludeFromRecents="true" android:taskAffinity="cn.local.usbtile.action" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <activity-alias android:name=".ReadStatus" android:targetActivity=".ToggleActivity"
            android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
